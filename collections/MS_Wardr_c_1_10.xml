   <text>
      <body>
         <div>
            <head>Georgian-English Dictionary</head>            
            <byline>
               Written by <persName>Major Wardrop</persName>
            </byline>            
            <head xml:lang="ka">ქართულ-ინგლისური ლექსიკონი</head>            
            <p>
               <date type="begun" when="1895-06-08">Begun: June 8th, 1895</date>
            </p>            
            <p>
               <date type="finished">Finished:</date>
            </p>
            <pb n="33/2r"/>
            <table>
               <row role="label">
                  <cell>Georgian letter</cell>
                  <cell>Description</cell>
               </row>               
               <row>
                  <cell>ბ</cell>
                  <cell>
                     <p>
                        <hi rend="italic">b</hi> is a consonant called in Georgian
                        <hi rend="italic">ban</hi> (ბან); its value numerically is 2,
                        but with the sign ღ (ღბ) it stands for 20 t’humans or roubles.
                     </p>
                     <p>
                        Before the letter <hi rend="italic">r</hi> (რ) it sometimes
                        changes into <hi rend="italic">m</hi> (მ) or
                        <hi rend="italic">p</hi> (პ), e.g.:
                        ბრუდე, მრუდე (bent, twisted);
                        ბრპენი, პრპენი (pewter, lead).
                        After the letter <hi rend="italic">b</hi> (ბ),
                        <hi rend="italic">r</hi> (რ) is sometimes left out altogether,
                        e.g.: ბრძანება, ბძანება (to command, order; to be).
                     </p>
                     <p>
                        <hi rend="italic">b</hi> is sometimes placed at the beginning of
                        a word for the sake of harmony
                        <add place="above">euphony</add>, e.g.:
                        ჟირი, ბჟირი (a kind of millet);
                        დღვილი, ბდღვილი (resin, tar, pitch).
                     </p>
                     <p>
                        Abbreviation:
                        <hi rend="italic">ბ-ნი</hi> (ბატონი = Mr).
                     </p>
                  </cell>
               </row>
            </table>
            
            <table>
               <row>
               <cell>ბაასი</cell>
               <cell>
                  (ცილობა, პაექრობა, ლაპარაკში შებმა);
                  dispute, discussion, contest, debate
               </cell>
               </row>               
               <row>
                  <cell>ბაასობა</cell>
                  <cell>
                     ვბაასობ, ვიბაასებ, ვებაასები (ვსცდილობ, ვპაექრობ);
                     debate, dispute, discuss; ნაბაასები
                  </cell>
               </row>               
               <row>
                  <cell>საბაასო</cell>
                  <cell>disputable</cell>
               </row>               
               <row>
                  <cell>ბაბა</cell>
                  <cell>childish expression for bread</cell>
               </row>
            </table>
            <pb n="34r"/>
            <table>
               <row>
                  <cell>ბაბანი</cell>
                  <cell><del rend="strikethrough">(თრთოლა)</del> trembling, shuddering</cell>
               </row>               
               <row>
                  <cell>ბაბაყული</cell>
                  <cell><del rend="strikethrough">(ბობოყველა)</del> a name of a bird</cell>
               </row>               
               <row>
                  <cell>ბაბაჭუა</cell>
                  <cell><del rend="strikethrough">(ობობა, დედა ზარდლისა)</del> spider</cell>
               </row>               
               <row>
                  <cell><del rend="strikethrough">ბაბათა</del></cell>
                  <cell/>
               </row>               
               <row>
                  <cell>ბაბთა</cell>
                  <cell><del rend="strikethrough">(ბადე, მაქმანი)</del> lace</cell>
               </row>               
               <row>
                  <cell>ბაბილო</cell>
                  <cell>
                     1. <del rend="strikethrough">(რქა ვაზთა ან სხვათა ნერგთა, ნორჩი, შიმალი)</del>
                     branch, bough, sprout, shoot.
                     <ref>Exek: XXXI-8; Ps: LXXX-10</ref>;
                     <lb/>
                     2. <del rend="strikethrough">(კრიჭინა, რძღვამლი, უსურვაზი, მორცხვლა)</del>
                     wild vine
                  </cell>
               </row>               
               <row>
                  <cell>ბაბრაბი</cell>
                  <cell><del rend="strikethrough">(ბაბრის ტყავი)</del> leopardskin, beaverskin</cell>
               </row>               
               <row>
                  <cell>ბაბრი</cell>
                  <cell>T. <del rend="strikethrough">(ჯიქი)</del> leopard, beaver</cell>
               </row>               
               <row>
                  <cell>ბაბღანი</cell>
                  <cell>T. parrot</cell>
               </row>               
               <row>
                  <cell>ბაბღანი<note type="editorial">Move this entry after <mentioned>ბაბუშველა</mentioned>.</note></cell>
                  <cell><del rend="strikethrough">(დათვის ტყავი)</del> bearskin</cell>
               </row>               
               <row>
                  <cell>ბაბუა</cell>
                  <cell>grandfather</cell>
               </row>               
               <row>
                  <cell>
                     ბაბუას საგძალი, ბაბუას წერი, ბაბუსაგძალა, ბაბუსსაგძალა
                  </cell>
                  <cell><del rend="strikethrough">(ბურბუშელა)</del> <hi rend="italic">Taraxacum officinale</hi></cell>
               </row>               
               <row>
                  <cell>ბაბუშველა</cell>
                  <cell><del rend="strikethrough">(დუდღუბო)</del> juniper berry</cell>
               </row>               
               <row>
                  <cell>ბაგა</cell>
                  <cell><del rend="strikethrough">(ახალი ვენახი, ჩაყრილი წინდები)</del>
                     a newly planted vine
                  </cell>
               </row>               
               <row>
                  <cell>ბაგა</cell>
                  <cell>
                     manger, crib; <hi rend="italic">ბაგათ-მთავარი</hi> chief groom
                  </cell>
               </row>               
               <row>
                  <cell>ბაგა</cell>
                  <cell>recess of a wall</cell>
               </row>               
               <row>
                  <cell>ბაგე</cell>
                  <cell>
                     lip; prow, stern of a vessel; bank of a stream;
                     <lb/>
                     <hi rend="italic">შერევნა ბაგეთა</hi> = confusion of language
                  </cell>
               </row>
            </table>
            <pb n="35/3r"/>
            <table>
               <row>
                  <cell>ბაგიანი, ბაგეებიანი</cell>
                  <cell>oral, verbal</cell>
               </row>               
               <row>
                  <cell>ბაგინი</cell>
                  <cell>(Arm. բագին) sanctuary, altar; victim</cell>
               </row>               
               <row>
                  <cell>ბაგირი</cell>
                  <cell>rope</cell>
               </row>               
               <row>
                  <cell>ბაგოვნები</cell>
                  <cell>roof, covering</cell>
               </row>               
               <row>
                  <cell>ბაგურჯავარი</cell>
                  <cell>benzoin</cell>
               </row>               
               <row>
                  <cell>ბადაგი</cell>
                  <cell>molasses, syrup</cell>
               </row>               
               <row>
                  <cell>ბადალი</cell>
                  <cell>(Arab. بدل) compensation, substitute; like, instead of</cell>
               </row>               
               <row>
                  <cell>ბადახშა, ბადახში, ბადახშანი</cell>
                  <cell>ruby</cell>
               </row>               
               <row>
                  <cell>ბადე</cell>
                  <cell>
                     net; everything in the form of a net;
                     <hi rend="italic">ბადე მაქმანი</hi> or <hi rend="italic">ნაქმანი</hi> lace;
                     <hi rend="italic">ბადე დედა ზარდლისა</hi> – spider’s web
                  </cell>
               </row>               
               <row>
                  <cell>ბადე-ბადე</cell>
                  <cell>in the form of a net</cell>
               </row>               
               <row>
                  <cell>ბადის პირი</cell>
                  <cell>opening of a fishing net</cell>
               </row>               
               <row>
                  <cell>ბადება</cell>
                  <cell>
                     (ვბადებ) to create, bear, produce, form;
                     (ვიბადები) to be born, created;
                     (მაბადია, გაბადია, აბადია – I have, thou hast, he has) to have
                  </cell>
               </row>               
               <row>
                  <cell>ბადეებიანი</cell>
                  <cell>(ბადეებრი) formed of nets</cell>
               </row>               
               <row>
                  <cell>ბადენი</cell>
                  <cell>(Arm. բագէս) linen garment; <bibl>Daniel X.5</bibl></cell>
               </row>               
               <row>
                  <cell>ბადვა, ბადუ̂ა</cell>
                  <cell>see <mentioned>ბადება</mentioned></cell>
               </row>               
               <row>
                  <cell>ბადია</cell>
                  <cell>(Per. باد) jar, goblet; dish</cell>
               </row>               
               <row>
                  <cell>ბადიანი</cell>
                  <cell>(Per. بادی) anise (<hi rend="italic">Illicium anisatum</hi>)</cell>
               </row>               
               <row>
                  <cell>ბადიმი</cell>
                  <cell>framework to cover a well</cell>
               </row>               
               <row>
                  <cell>ბადის პირი</cell>
                  <cell>hauling rope</cell>
               </row>
            </table>
            <pb n="36/4r"/>
            <table>
               <row>
                  <cell>ბადიში</cell>
                  <cell>grandson</cell>
               </row>               
               <row>
                  <cell>ბადლიჯანი</cell>
                  <cell>see <mentioned>ბადრიჯანი</mentioned></cell>
               </row>
               <row>
                  <cell>ბადრაგა</cell>
                  <cell>convoy, escort</cell>
               </row>               
               <row>
                  <cell>ბადრაგი</cell>
                  <cell><hi rend="italic">citron</hi> (<hi rend="italic">Citrus medica</hi>, Risso)</cell>
               </row>               
               <row>
                  <cell>ბადრაგობა</cell>
                  <cell>to escort</cell>
               </row>               
               <row>
                  <cell>ბადრი</cell>
                  <cell>(Arabic بدر) full moon</cell>
               </row>               
               <row>
                  <cell>ბადრიჯანი</cell>
                  <cell>(Per. بادنجان) aubergine (<hi rend="italic">Solanum melongena</hi>)</cell>
               </row>               
               <row>
                  <cell>ბადრობა</cell>
                  <cell>
                     fulness of the moon, equality;
                     to be equal to, to compare, to liken
                  </cell>
               </row>               
               <row>
                  <cell>ბადრუკი</cell>
                  <cell>unfortunate, unhappy, miserable, horrible</cell>
               </row>               
               <row>
                  <cell>ბადრუკობა</cell>
                  <cell>misfortune; to be unfortunate</cell>
               </row>               
               <row>
                  <cell>ბავასირი</cell>
                  <cell>see <mentioned>ბუასილი</mentioned></cell>
               </row>               
               <row>
                  <cell>ბავთება, ბავთი</cell>
                  <cell>(Arm. բադենի) bad news</cell>
               </row>               
               <row>
                  <cell>ბავთის მიმღები</cell>
                  <cell>a hearer of bad things</cell>
               </row>               
               <row>
                  <cell>ბავლი</cell>
                  <cell>first bird caught by a falcon</cell>
               </row>               
               <row>
                  <cell>ბავრაკი</cell>
                  <cell>(T. بيراق) flag, standard</cell>
               </row>               
               <row>
                  <cell>ბავრუკი</cell>
                  <cell>(Arab. بورق) borax (<hi rend="italic">borax tincal</hi>)</cell>
               </row>
               <row>
                  <cell>ბავშვი</cell>
                  <cell>child; <hi rend="italic">ბავშვობა</hi> childhood</cell>
               </row>               
               <row>
                  <cell>ბაზაზი</cell>
                  <cell>a dealer in small goods</cell>
               </row>               
               <row>
                  <cell>ბაზარგებითა</cell>
                  <cell>a house built among shops</cell>
               </row>               
               <row>
                  <cell>ბაზარი</cell>
                  <cell>(Pers. بزار) market, bazaar</cell>
               </row>               
               <row>
                  <cell>ბაზი</cell>
                  <cell>(Pers. باز) falcon (<hi rend="italic">Falco gentilis</hi>)</cell>
               </row>
            </table>
            <pb n="36/4v"/>
            <table>
               <row>
                  <cell>ბათილამი</cell>
                  <cell/>
               </row>               
               <row>
                  <cell>ბათილი</cell>
                  <cell>
                     (Arab.) empty, waste, annihilated;
                     <hi rend="italic">ბათილების წერილი</hi> = an invalid document
                  </cell>
               </row>               
               <row>
                  <cell>ბათილება</cell>
                  <cell>to annihilate, destroy</cell>
               </row>
            </table>
            <pb n="37/5r"/>
            <table>
               <row>
                  <cell>ბაზიერი</cell>
                  <cell>
                     falconer;
                     <hi rend="italic">ბაზიერთ-უხუცესი</hi> chief falconer
                  </cell>
               </row>               
               <row>
                  <cell>ბაზივრობა</cell>
                  <cell>falconry</cell>
               </row>               
               <row>
                  <cell>ბაზიკი</cell>
                  <cell>see <mentioned>ბეზეკი</mentioned></cell>
               </row>               
               <row>
                  <cell>ბაზმა, ბაზმაკი</cell>
                  <cell>(Arm. լամպ) lamp</cell>
               </row>               
               <row>
                  <cell>ბაზმანდი</cell>
                  <cell>(Pers. بازو بند) amulet, talisman</cell>
               </row>               
               <row>
                  <cell>ბაზმანდი</cell>
                  <cell>bezman, a Roman weight</cell>
               </row>               
               <row>
                  <cell>ბაზმანდიანი</cell>
                  <cell>one who carries talismans with him</cell>
               </row>               
               <row>
                  <cell>ბაზრობა, ბაზრიანობა</cell>
                  <cell>fair, mart</cell>
               </row>               
               <row>
                  <cell>ბაზრული</cell>
                  <cell>saleable</cell>
               </row>               
               <row>
